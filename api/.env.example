# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Proxies reversos na frente da API (0 = nenhum; 1 atrás de Nginx/Traefik). Necessário
# para o rate limit enxergar o IP real do cliente.
TRUST_PROXY_HOPS=0

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soufer_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Autenticação JWT
JWT_SECRET=soufer_tools_super_secret_jwt_key_development_2026
JWT_EXPIRES_IN=7d
JWT_CONSULTA_EXPIRES_IN=15m
