# Servidor
PORT=
NODE_ENV=
CORS_ORIGIN=
# Proxies reversos na frente da API (0 = nenhum; 1 atrás de Nginx/Traefik). Necessário
# para o rate limit enxergar o IP real do cliente.
TRUST_PROXY_HOPS=

# Banco de Dados PostgreSQL
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=

# Autenticação JWT
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_CONSULTA_EXPIRES_IN=
